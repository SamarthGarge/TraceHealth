# MongoDB (Atlas M0 free tier)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthrisk
MONGO_DB_NAME=healthrisk

# JWT — sign/verify all tokens locally (no external auth service)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin account (created via POST /api/auth/admin/setup — run once after first deploy)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# SMTP — Gmail for password reset emails
# 1. Create a Gmail account (e.g. tracehealth.noreply@gmail.com)
# 2. Enable 2-Step Verification at myaccount.google.com/security
# 3. Create an App Password at myaccount.google.com/apppasswords
# 4. Paste the 16-char code below (spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tracehealth.noreply@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=TraceHealth

# CORS
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_ALLOWED_ORIGINS=

# App
ENVIRONMENT=development    # "development" | "production"

# ML model artifacts path (relative to backend/ directory)
# Use /app/models inside Docker (overridden by docker-compose.yml environment block)
MODELS_DIR=../models
