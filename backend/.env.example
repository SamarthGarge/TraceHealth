# MongoDB (same Atlas cluster the auth-service uses)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=healthrisk

# Auth — FastAPI verifies tokens issued by the auth-service, never issues its own.
# See docs/Auth_Service_Architecture.md for the full JWT/JWKS rationale.
AUTH_SERVICE_URL=http://localhost:4000

# CORS — frontend dev server origin
FRONTEND_ORIGIN=http://localhost:5173
# Optional: comma-separated list of additional allowed origins (e.g., staging URLs)
EXTRA_ALLOWED_ORIGINS=

# App
ENVIRONMENT=development   # "development" | "production"

# Path to trained model artifacts (relative to backend/ root)
MODELS_DIR=../../models
